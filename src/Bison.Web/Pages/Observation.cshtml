@page "/ob/{id:int?}"
@model Bison.Web.Pages.ObservationModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    @if (Model.Observation != null)
    {
        <h2> Observation @Model.Observation.Id</h2>
        <p><strong>@Model.Observation.Author</strong></p>
        <p> @Model.Observation.Message</p>
        @if (!string.IsNullOrEmpty(Model.Observation.PicturePath))
        {
            <img class="observation-picture" src="@Model.Observation.PicturePath" alt="Picture posted by @Model.Observation.Author" />
        }
        <small> @Model.Observation.Timestamp</small>

        <h3>Comments</h3>
        @if (Model.Comments.Any())
        {
            <ul>
                @foreach (var comment in Model.Comments)
                {
                    <li>
                        <strong>@comment.Author</strong>
                        <small>@comment.Timestamp</small>
                        <p>@comment.Message</p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No comments found</p>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page-handler="Comment" asp-route-id="@Model.Observation.Id">
                <label for="CommentText">Write a comment</label>
                <textarea asp-for="CommentText" rows="3"></textarea>
                <span asp-validation-for="CommentText" class="text-danger"></span>
                <button type="submit">Add comment</button>
            </form>
        }

        <h3>Proposals</h3>
        @if (Model.Proposals.Any())
        {
            <ul>
                @foreach (var proposal in Model.Proposals)
                {
                    <li>
                        <strong>@proposal.Author</strong>
                        <small>@proposal.Timestamp</small>
                        <p>Proposed animal: @proposal.TaxonName</p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No proposals found</p>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page-handler="Proposal" asp-route-id="@Model.Observation.Id">
                <label for="ProposalTaxonId">Propose an animal</label>
                <select asp-for="ProposalTaxonId" asp-items="@(new SelectList(Model.Taxa, "TaxonId", "VernacularName"))">
                    <option value="">Choose an animal</option>
                </select>
                <span asp-validation-for="ProposalTaxonId" class="text-danger"></span>
                <button type="submit">Add proposal</button>
            </form>
        }
        else
        {
            <p>Log in to write comments and proposals.</p>
        }
    }
    else
    {
        <h2>All Observations</h2>
        @if (Model.Observations.Any())
        {
            <ul>
                @foreach (var observation in Model.Observations)
                {
                    <li>
                        <a href="/ob/@observation.Id">@observation.Message</a>
                        <small>by @observation.Author</small>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No observations found</p>
        }
    }
</div>