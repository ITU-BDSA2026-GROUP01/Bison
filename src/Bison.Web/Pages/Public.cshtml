@page "/"
@model Bison.Web.Pages.PublicModel
@{
    ViewData["Title"] = "Chirp!";
    Layout = "Shared/_Layout";
}

<div class="public-layout @(Model.IsFiltered ? "filter-open" : "")">
    <div class="public-main">
        <div class="public-header">
            <h2> Public Observations</h2>
            <button type="button" id="filter-toggle">Filter</button>
        </div>

          @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="cheepbox">
                <h3>What did you see, @User.Identity.Name?</h3>
                <form method="post" enctype="multipart/form-data">
                    <label for="Text">Observation</label>
                    <input type="text" asp-for="Text" />
                    <label for="NewTaxonId">Taxon</label>
                    <select asp-for="NewTaxonId">
                        <option value="">Choose taxon</option>
                        @foreach (var taxon in Model.Taxa)
                        {
                            <option value="@taxon.TaxonId">@taxon.VernacularName</option>
                        }
                    </select>
                    <input type="submit" value="Share" />
            <div>
                    <label for="Picture">Picture (optional)</label>
                    <input type="file" asp-for="Picture" accept="image/jpeg,image/png,image/gif,image/webp" />
                    <span class="text-danger" asp-validation-for="Picture"></span>
                    <label for="PictureLicense">Picture license (optional)</label>
                    <select asp-for="PictureLicense">
                        <option value="">No license (all rights reserved)</option>
                        @foreach (var (code, label) in PictureLicenses.Options)
                        {
                            <option value="@code">@label</option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="PictureLicense"></span>
            </div>       
                    <span class="text-danger" asp-validation-for="Text"></span>
                    <span class="text-danger" asp-validation-for="NewTaxonId"></span>
                </form>
            </div>
        }

        @if (Model.Cheeps.Any())
        {
            <ul id="messagelist" class="cheeps">
                @foreach (var cheep in Model.Cheeps)
                {
                    <li>
                        <p>
                            <strong>
                                <a href="/@cheep.Author">@cheep.Author</a>
                            </strong>
                            <a href="/ob/@cheep.Id">@cheep.Message</a>
                            <small>&mdash; @cheep.Timestamp</small>
                        </p>
                        @if (!string.IsNullOrEmpty(cheep.PicturePath))
                        {
                             <img class="observation-picture" src="@cheep.PicturePath" alt="Picture posted by @cheep.Author" />
                             @if (!string.IsNullOrEmpty(cheep.PictureLicense))
                             {
                                 <p><small>Picture: @PictureLicenses.LabelFor(cheep.PictureLicense)</small></p>
                             }
                        }
                    </li>
                }
            </ul>
        }
        else if (!Model.IsFiltered)
        {
            <em>There are no cheeps so far.</em>
        }
    </div>

    <aside class="public-filter">
        <form method="get" action="/" id="taxon-filter">
            <label for="taxonId">Filter by taxon:</label>
            <select name="taxonId" id="taxonId" size="@(Model.Taxa.Count + 1)" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var taxon in Model.Taxa)
                {
                    <option value="@taxon.TaxonId" selected="@(Model.SelectedTaxonId == taxon.TaxonId)">
                        @taxon.VernacularName</option>
                    }
                </select>
                <noscript><button type="submit">Filter</button></noscript>
            </form>
        </aside>
    </div>

    <script>
        document.getElementById('filter-toggle').addEventListener('click', function () {
            document.querySelector('.public-layout').classList.toggle('filter-open');
        });
    </script>