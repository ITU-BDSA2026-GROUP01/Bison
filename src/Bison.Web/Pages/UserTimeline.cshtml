@page "/{author}"
@model Bison.Web.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Chirp!";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2>@(Model.IsOwnTimeline ? "My Observations" : $"{routeName}'s Observations")</h2>

    @if (Model.IsOwnTimeline)
    {
        <div class="cheepbox">
            <h3>What did you see, @User.Identity!.Name?</h3>
            <form method="post">
                <input type="text" asp-for="Text" />
                <select asp-for="NewTaxonId">
                    <option value="">Choose taxon</option>
                    @foreach (var taxon in Model.Taxa)
                    {
                        <option value="@taxon.TaxonId">@taxon.VernacularName</option>
                    }
                </select>
                <input type="submit" value="Share" />
                <span class="text-danger" asp-validation-for="Text"></span>
                <span class="text-danger" asp-validation-for="NewTaxonId"></span>
            </form>
        </div>
    }

    @if (Model.Cheeps.Any())
    {
        <ul id="messagelist" class="cheeps">
            @foreach (var cheep in Model.Cheeps)
            {
                <li>
                    <p>
                        <strong><a href="/@cheep.Author">@cheep.Author</a></strong>
                        @cheep.Message
                        <small>&mdash; @cheep.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no cheeps so far.</em>
    }
</div>