@page "/{author}"
@model Bison.Web.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bouffalant!";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2>@(Model.IsOwnTimeline ? "My Observations" : $"{routeName}'s Observations")</h2>

    @if (Model.IsOwnTimeline)
    {
        <div class="cheepbox">
            <h3>What did you see, @User.Identity!.Name?</h3>
            <form method="post" enctype="multipart/form-data">
                <input type="text" asp-for="Text" />
                <select asp-for="NewTaxonId">
                    <option value="">Choose taxon</option>
                    @foreach (var taxon in Model.Taxa)
                    {
                        <option value="@taxon.TaxonId">@taxon.VernacularName</option>
                    }
                </select>
                <input type="submit" value="Share" />
        <div>
                <label for="Picture">Picture, video or audio (optional)</label>
                <input type="file" asp-for="Picture" accept=".jpg,.jpeg,.png,.gif,.webp,.mp4,.webm,.mp3,.m4a,.ogg" />
                <span class="text-danger" asp-validation-for="Picture"></span>
                <label for="PictureLicense">License</label>
                <select asp-for="PictureLicense" required>
                    @foreach (var (code, label) in PictureLicenses.Options)
                    {
                        <option value="@code">@label</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="PictureLicense"></span>
        </div>
                <span class="text-danger" asp-validation-for="Text"></span>
                <span class="text-danger" asp-validation-for="NewTaxonId"></span>
            </form>
        </div>
    }

    @if (Model.Cheeps.Any())
    {
        <ul id="messagelist" class="cheeps">
            @foreach (var cheep in Model.Cheeps)
            {
                <li>
                    <p>
                        <strong>
                                <a href="/@cheep.Author">@cheep.Author</a>
                        </strong>
                        <a href="/ob/@cheep.Id">@cheep.Message</a>
                        <small>&mdash; @cheep.Timestamp</small>
                    </p>
                    <partial name="_Media" model="cheep" />
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no cheeps so far.</em>
    }
</div>